# Archivo de configuración de variables de entorno para la aplicación web
# Copiar este archivo a .env.local y llenar con valores reales

# Variables públicas (accesibles en el navegador)
NEXT_PUBLIC_DAO_CONTRACT_ADDRESS=0x
NEXT_PUBLIC_FORWARDER_CONTRACT_ADDRESS=0x
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Variables privadas (solo servidor)
RELAYER_PRIVATE_KEY=0x
RELAYER_ADDRESS=0x
RPC_URL=http://127.0.0.1:8545

# Configuración del daemon
DAEMON_INTERVAL=300000  # 5 minutos en milisegundos
