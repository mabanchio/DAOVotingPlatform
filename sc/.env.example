# Archivo de configuración de variables de entorno para Smart Contracts
# Copiar este archivo a .env y llenar con valores reales

# Clave privada del desplegador (sin 0x)
PRIVATE_KEY=

# URL del RPC (local o testnet)
RPC_URL=http://127.0.0.1:8545

# Saldo mínimo requerido para votar (en wei)
# 0.1 ETH = 100000000000000000
MINIMUM_BALANCE=100000000000000000

# Tiempo de ejecución demorado para propuestas (en segundos)
# 1 día = 86400
EXECUTION_DELAY=86400

# Dirección del forwarder (se obtiene después del deploy)
FORWARDER_ADDRESS=

# Dirección del contrato DAO (se obtiene después del deploy)
DAO_ADDRESS=
